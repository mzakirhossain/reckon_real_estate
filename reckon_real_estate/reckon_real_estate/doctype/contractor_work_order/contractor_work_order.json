{
  "doctype": "DocType",
  "name": "Contractor Work Order",
  "module": "Reckon Real Estate",
  "autoname": "format:CWO-{YYYY}-{#####}",
  "is_submittable": 1,
  "track_changes": 1,
  "field_order": [
    "project",
    "company",
    "contractor",
    "boq",
    "start_date",
    "end_date",
    "status",
    "items",
    "total_amount",
    "retention_percent",
    "purchase_order",
    "terms"
  ],
  "fields": [
    {
      "fieldname": "project",
      "fieldtype": "Link",
      "options": "Real Estate Project",
      "reqd": 1,
      "label": "Project"
    },
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "options": "Company",
      "reqd": 1,
      "label": "Company"
    },
    {
      "fieldname": "contractor",
      "fieldtype": "Link",
      "options": "Contractor",
      "reqd": 1,
      "label": "Contractor"
    },
    {
      "fieldname": "boq",
      "fieldtype": "Link",
      "options": "BOQ",
      "label": "BOQ"
    },
    {
      "fieldname": "start_date",
      "fieldtype": "Date",
      "default": "Today",
      "reqd": 1,
      "label": "Start Date"
    },
    {
      "fieldname": "end_date",
      "fieldtype": "Date",
      "reqd": 1,
      "label": "End Date"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "options": "Draft\nIssued\nIn Progress\nCompleted\nClosed\nCancelled",
      "default": "Draft",
      "label": "Status"
    },
    {
      "fieldname": "items",
      "fieldtype": "Table",
      "options": "Work Order Item",
      "reqd": 1,
      "label": "Items"
    },
    {
      "fieldname": "total_amount",
      "fieldtype": "Currency",
      "read_only": 1,
      "label": "Total Amount"
    },
    {
      "fieldname": "retention_percent",
      "fieldtype": "Percent",
      "default": "0",
      "label": "Retention Percent"
    },
    {
      "fieldname": "purchase_order",
      "fieldtype": "Link",
      "options": "Purchase Order",
      "read_only": 1,
      "label": "Purchase Order"
    },
    {
      "fieldname": "terms",
      "fieldtype": "Text Editor",
      "label": "Terms"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC"
}
