      "default": "Today"
    },
    {
      "fieldname": "customer",
      "fieldtype": "Link",
      "label": "Customer",
      "reqd": 1,
      "options": "Customer"
    },
    {
      "fieldname": "project",
      "fieldtype": "Link",
      "label": "Project",
      "reqd": 1,
      "options": "Real Estate Project"
    },
    {
      "fieldname": "unit",
      "fieldtype": "Link",
      "label": "Unit",
      "reqd": 1,
      "options": "Real Estate Unit"
    },
    {
      "fieldname": "booking",
      "fieldtype": "Link",
      "label": "Booking",
      "reqd": 0,
      "options": "Property Booking"
    },
    {
      "fieldname": "payment_mode",
      "fieldtype": "Link",
      "label": "Payment Mode",
      "reqd": 1,
      "options": "Mode of Payment"
    },
    {
      "fieldname": "reference_no",
      "fieldtype": "Data",
      "label": "Reference No",
      "reqd": 0
    },
    {
      "fieldname": "amount",
      "fieldtype": "Currency",
      "label": "Amount",
      "reqd": 1
    },
    {
      "fieldname": "allocations",
      "fieldtype": "Table",
      "label": "Payment Allocation",
      "options": "Payment Allocation"
    },
    {
      "fieldname": "allocated_amount",
      "fieldtype": "Currency",
      "label": "Allocated Amount",
      "reqd": 0,
      "read_only": 1
    },
    {
      "fieldname": "unallocated_amount",
      "fieldtype": "Currency",
      "label": "Unallocated Amount",
      "reqd": 0,
      "read_only": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "reqd": 0,
      "options": "Draft\nSubmitted\nCancelled",
      "default": "Draft"
    },
    {
      "fieldname": "remarks",
      "fieldtype": "Small Text",
      "label": "Remarks",
      "reqd": 0
    },
    {
      "fieldname": "document_status",
      "label": "Document Status",
      "fieldtype": "Select",
      "options": "Draft\nSubmitted\nCancelled",
      "default": "Draft",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "amended_from",
      "label": "Amended From",
      "fieldtype": "Link",
      "options": "Collection Entry",
      "read_only": 1,
      "no_copy": 1,
      "hidden": 1
    },
    {
      "fieldname": "details_section",
      "label": "Details",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "totals_section",
      "label": "Totals",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "allocations_section",
      "label": "Allocations",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "details_column",
      "label": "Details Column",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "payment_entry",
      "label": "ERPNext Payment Entry",
      "fieldtype": "Link",
      "options": "Payment Entry",
      "read_only": 1
    },
    {
      "fieldname": "accounting_status",
      "label": "Accounting Status",
      "fieldtype": "Select",
      "options": "Not Created\nDraft Payment\nPosted\nCancelled",
      "default": "Not Created",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "title_field": "collection_no",
  "is_submittable": 1
}
