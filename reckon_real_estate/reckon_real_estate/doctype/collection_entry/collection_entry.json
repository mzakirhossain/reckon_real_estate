{
  "doctype": "DocType",
  "name": "Collection Entry",
  "module": "Reckon Real Estate",
  "autoname": "format:CE-{YYYY}-{#####}",
  "allow_rename": 1,
  "engine": "InnoDB",
  "field_order": [
    "collection_no",
    "details_section",
    "collection_date",
    "customer",
    "project",
    "unit",
    "booking",
    "details_column",
    "payment_mode",
    "reference_no",
    "amount",
    "status",
    "document_status",
    "payment_entry",
    "accounting_status",
    "allocations_section",
    "allocations",
    "totals_section",
    "allocated_amount",
    "unallocated_amount",
    "remarks",
    "amended_from"
  ],
  "fields": [
    {
