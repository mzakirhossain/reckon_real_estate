      "label": "Collection No",
      "reqd": 0,
      "read_only": 1,
      "unique": 1,
      "no_copy": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "collection_date",
      "fieldtype": "Date",
      "label": "Collection Date",
