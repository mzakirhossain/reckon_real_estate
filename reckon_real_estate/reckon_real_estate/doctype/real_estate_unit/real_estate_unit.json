{
  "doctype": "DocType",
  "name": "Real Estate Unit",
  "module": "Reckon Real Estate",
  "autoname": "format:REU-{YYYY}-{#####}",
  "allow_rename": 1,
  "engine": "InnoDB",
  "field_order": [
    "unit_code",
    "details_section",
    "unit_no",
    "project",
    "building",
    "floor",
    "unit_type",
    "unit_category",
    "details_column",
    "area_sqft",
    "bedrooms",
    "bathrooms",
    "facing",
    "base_rate_per_sqft",
    "list_price",
    "status",
    "document_status",
    "erpnext_item",
    "land_section",
    "land_parcel",
    "proportionate_land_area",
    "land_share_percent",
    "jv_allocation",
    "description_section",
    "description",
    "amended_from"
  ],
  "fields": [
    {
      "fieldname": "unit_code",
      "fieldtype": "Data",
      "label": "Unit Code",
      "reqd": 0,
      "read_only": 1,
      "unique": 1,
      "no_copy": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "unit_no",
      "fieldtype": "Data",
      "label": "Unit No",
      "reqd": 1
    },
    {
      "fieldname": "project",
      "fieldtype": "Link",
      "label": "Project",
      "reqd": 1,
      "options": "Real Estate Project"
    },
    {
      "fieldname": "building",
      "fieldtype": "Link",
      "label": "Building",
      "reqd": 1,
      "options": "Real Estate Building"
    },
    {
      "fieldname": "floor",
      "fieldtype": "Link",
      "label": "Floor",
      "reqd": 1,
      "options": "Real Estate Floor"
    },
    {
      "fieldname": "unit_type",
      "fieldtype": "Select",
      "label": "Unit Type",
      "reqd": 0,
      "options": "Apartment\nOffice\nShop\nPlot\nParking\nOther"
    },
    {
      "fieldname": "unit_category",
      "fieldtype": "Data",
      "label": "Unit Category",
      "reqd": 0
    },
    {
      "fieldname": "area_sqft",
      "fieldtype": "Float",
      "label": "Area (Sqft)",
      "reqd": 1
    },
    {
      "fieldname": "bedrooms",
      "fieldtype": "Int",
      "label": "Bedrooms",
      "reqd": 0
    },
    {
      "fieldname": "bathrooms",
      "fieldtype": "Int",
      "label": "Bathrooms",
      "reqd": 0
    },
    {
      "fieldname": "facing",
      "fieldtype": "Data",
      "label": "Facing",
      "reqd": 0
    },
    {
      "fieldname": "base_rate_per_sqft",
      "fieldtype": "Currency",
      "label": "Base Rate / Sqft",
      "reqd": 0
    },
    {
      "fieldname": "list_price",
      "fieldtype": "Currency",
      "label": "List Price",
      "reqd": 0,
      "read_only": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "reqd": 0,
      "options": "Available\nReserved\nBooked\nSold\nBlocked\nCancelled\nHandover Pending\nHanded Over",
      "default": "Available"
    },
    {
      "fieldname": "erpnext_item",
      "fieldtype": "Link",
      "label": "ERPNext Item",
      "reqd": 0,
      "options": "Item"
    },
    {
      "fieldname": "description",
      "fieldtype": "Text Editor",
      "label": "Description",
      "reqd": 0
    },
    {
      "fieldname": "land_section",
      "label": "Proportionate Land",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "land_parcel",
      "label": "Land Parcel",
      "fieldtype": "Link",
      "options": "Land Parcel",
      "read_only": 1
    },
    {
      "fieldname": "proportionate_land_area",
      "label": "Proportionate Land Area",
      "fieldtype": "Float",
      "read_only": 1
    },
    {
      "fieldname": "land_share_percent",
      "label": "Land Share %",
      "fieldtype": "Percent",
      "read_only": 1
    },
    {
      "fieldname": "jv_allocation",
      "label": "JV Allocation",
      "fieldtype": "Link",
      "options": "JV Allocation",
      "read_only": 1
    },
    {
      "fieldname": "document_status",
      "label": "Document Status",
      "fieldtype": "Select",
      "options": "Draft\nSubmitted\nCancelled",
      "default": "Draft",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "amended_from",
      "label": "Amended From",
      "fieldtype": "Link",
      "options": "Real Estate Unit",
      "read_only": 1,
      "no_copy": 1,
      "hidden": 1
    },
    {
      "fieldname": "details_section",
      "label": "Details",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "description_section",
      "label": "Description",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "details_column",
      "label": "Details Column",
      "fieldtype": "Column Break"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "title_field": "unit_no",
  "is_submittable": 1
}
