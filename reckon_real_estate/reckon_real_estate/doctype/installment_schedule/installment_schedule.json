{
  "doctype": "DocType",
  "name": "Installment Schedule",
  "module": "Reckon Real Estate",
  "autoname": "hash",
  "allow_rename": 1,
  "engine": "InnoDB",
  "field_order": [
    "installment_no",
    "due_date",
    "description",
    "principal",
    "other_charges",
    "total_amount",
    "paid_amount",
    "outstanding",
    "status",
    "sales_invoice"
