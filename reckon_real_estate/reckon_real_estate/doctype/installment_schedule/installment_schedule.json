      "options": "Upcoming\nDue\nPartial\nPaid\nOverdue\nWaived\nCancelled",
      "default": "Upcoming",
      "read_only": 1,
      "in_list_view": 0
    },
    {
      "fieldname": "sales_invoice",
      "label": "Sales Invoice",
      "fieldtype": "Link",
      "options": "Sales Invoice",
      "read_only": 1,
      "in_list_view": 1,
      "columns": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1
