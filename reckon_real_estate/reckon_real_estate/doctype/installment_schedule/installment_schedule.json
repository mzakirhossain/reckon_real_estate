      "reqd": 1,
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "description",
      "fieldtype": "Data",
      "label": "Description",
      "reqd": 0,
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "principal",
      "fieldtype": "Currency",
      "label": "Principal",
      "reqd": 0,
      "in_list_view": 0
    },
    {
      "fieldname": "other_charges",
      "fieldtype": "Currency",
      "label": "Other Charges",
      "reqd": 0,
      "in_list_view": 0
    },
    {
      "fieldname": "total_amount",
      "fieldtype": "Currency",
      "label": "Total Amount",
      "reqd": 0,
      "read_only": 1,
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "paid_amount",
      "fieldtype": "Currency",
      "label": "Paid Amount",
      "reqd": 0,
      "read_only": 1,
      "in_list_view": 1,
      "columns": 1
    },
    {
      "fieldname": "outstanding",
      "fieldtype": "Currency",
      "label": "Outstanding",
      "reqd": 0,
      "read_only": 1,
      "in_list_view": 1,
      "columns": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
