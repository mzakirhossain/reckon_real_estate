{
  "doctype": "DocType",
  "name": "Measurement Sheet",
  "module": "Reckon Real Estate",
  "autoname": "format:MS-{YYYY}-{#####}",
  "is_submittable": 1,
  "track_changes": 1,
  "field_order": [
    "measurement_no",
    "details_section",
    "work_order",
    "measurement_date",
    "period_from",
    "period_to",
    "details_column",
    "project",
    "contractor",
    "status",
    "certified_by",
    "items_section",
    "items",
    "totals_section",
    "total_amount",
    "remarks",
    "amended_from"
  ],
  "fields": [
    {
      "fieldname": "work_order",
      "fieldtype": "Link",
      "options": "Contractor Work Order",
      "reqd": 1,
      "label": "Work Order"
    },
    {
      "fieldname": "project",
      "fieldtype": "Link",
      "options": "Real Estate Project",
      "read_only": 1,
      "label": "Project"
    },
    {
      "fieldname": "contractor",
      "fieldtype": "Link",
      "options": "Contractor",
      "read_only": 1,
      "label": "Contractor"
    },
    {
      "fieldname": "measurement_date",
      "fieldtype": "Date",
      "default": "Today",
      "reqd": 1,
      "label": "Measurement Date"
    },
    {
      "fieldname": "period_from",
      "fieldtype": "Date",
      "reqd": 1,
      "label": "Period From"
    },
    {
      "fieldname": "period_to",
      "fieldtype": "Date",
      "reqd": 1,
      "label": "Period To"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "options": "Draft\nSubmitted\nCancelled",
      "default": "Draft",
      "label": "Status",
      "read_only": 1
    },
    {
      "fieldname": "items",
      "fieldtype": "Table",
      "options": "Measurement Item",
      "reqd": 1,
      "label": "Items"
    },
    {
      "fieldname": "total_amount",
      "fieldtype": "Currency",
      "read_only": 1,
      "label": "Total Amount"
    },
    {
      "fieldname": "certified_by",
      "fieldtype": "Link",
      "options": "User",
      "label": "Certified By"
    },
    {
      "fieldname": "remarks",
      "fieldtype": "Small Text",
      "label": "Remarks"
    },
    {
      "fieldname": "measurement_no",
      "label": "Measurement No",
      "fieldtype": "Data",
      "read_only": 1,
      "in_list_view": 1,
      "unique": 1,
      "no_copy": 1
    },
    {
      "fieldname": "items_section",
      "label": "Items",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "details_section",
      "label": "Details",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "details_column",
      "label": "Details Column",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "totals_section",
      "label": "Totals",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "amended_from",
      "label": "Amended From",
      "fieldtype": "Link",
      "options": "Measurement Sheet",
      "read_only": 1,
      "no_copy": 1,
      "hidden": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC"
}
