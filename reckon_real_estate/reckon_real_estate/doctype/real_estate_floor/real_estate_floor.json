{
  "doctype": "DocType",
  "name": "Real Estate Floor",
  "module": "Reckon Real Estate",
  "autoname": "format:REF-{YYYY}-{#####}",
  "allow_rename": 1,
  "engine": "InnoDB",
  "field_order": [
    "floor_code",
    "details_section",
    "floor_name",
    "project",
    "building",
    "details_column",
    "floor_number",
    "status",
    "document_status",
    "amended_from"
  ],
  "fields": [
    {
      "fieldname": "floor_code",
      "fieldtype": "Data",
      "label": "Floor Code",
      "reqd": 0,
      "read_only": 1,
      "unique": 1,
      "no_copy": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "floor_name",
      "fieldtype": "Data",
      "label": "Floor Name",
      "reqd": 1
    },
    {
      "fieldname": "project",
      "fieldtype": "Link",
      "label": "Project",
      "reqd": 1,
      "options": "Real Estate Project"
    },
    {
      "fieldname": "building",
      "fieldtype": "Link",
      "label": "Building",
      "reqd": 1,
      "options": "Real Estate Building"
    },
    {
      "fieldname": "floor_number",
      "fieldtype": "Int",
      "label": "Floor Number",
      "reqd": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "reqd": 0,
      "options": "Active\nInactive",
      "default": "Active"
    },
    {
      "fieldname": "document_status",
      "label": "Document Status",
      "fieldtype": "Select",
      "options": "Draft\nSubmitted\nCancelled",
      "default": "Draft",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "amended_from",
      "label": "Amended From",
      "fieldtype": "Link",
      "options": "Real Estate Floor",
      "read_only": 1,
      "no_copy": 1,
      "hidden": 1
    },
    {
      "fieldname": "details_section",
      "label": "Details",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "details_column",
      "label": "Details Column",
      "fieldtype": "Column Break"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "title_field": "floor_name",
  "is_submittable": 1
}
