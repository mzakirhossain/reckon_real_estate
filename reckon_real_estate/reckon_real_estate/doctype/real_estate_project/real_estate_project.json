{
  "doctype": "DocType",
  "name": "Real Estate Project",
  "module": "Reckon Real Estate",
  "autoname": "format:REP-{YYYY}-{#####}",
  "allow_rename": 1,
  "engine": "InnoDB",
  "field_order": [
    "project_code",
    "details_section",
    "project_name",
    "company",
    "project_type",
    "start_date",
    "expected_completion_date",
    "details_column",
    "erpnext_project",
    "cost_center",
    "project_warehouse",
    "default_income_account",
    "status",
    "document_status",
    "location",
    "property_section",
    "address",
    "land_area",
    "total_floors",
    "total_units",
    "notes",
    "amended_from"
  ],
  "fields": [
    {
      "fieldname": "project_code",
      "fieldtype": "Data",
      "label": "Project Code",
      "reqd": 0,
      "read_only": 1,
      "unique": 1,
      "no_copy": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "project_name",
      "fieldtype": "Data",
      "label": "Project Name",
      "reqd": 1
    },
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "label": "Company",
      "reqd": 1,
      "options": "Company"
    },
    {
      "fieldname": "erpnext_project",
      "fieldtype": "Link",
      "label": "ERPNext Project",
      "reqd": 0,
      "options": "Project"
    },
    {
      "fieldname": "cost_center",
      "fieldtype": "Link",
      "label": "Cost Center",
      "reqd": 0,
      "options": "Cost Center"
    },
    {
      "fieldname": "project_type",
      "fieldtype": "Select",
      "label": "Project Type",
      "reqd": 0,
      "options": "Residential\nCommercial\nMixed Use\nLand Development\nOther"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "reqd": 0,
      "options": "Planning\nActive\nOn Hold\nCompleted\nCancelled",
      "default": "Planning"
    },
    {
      "fieldname": "start_date",
      "fieldtype": "Date",
      "label": "Start Date",
      "reqd": 0
    },
    {
      "fieldname": "expected_completion_date",
      "fieldtype": "Date",
      "label": "Expected Completion Date",
      "reqd": 0
    },
    {
      "fieldname": "location",
      "fieldtype": "Data",
      "label": "Location",
      "reqd": 0
    },
    {
      "fieldname": "address",
      "fieldtype": "Small Text",
      "label": "Address",
      "reqd": 0
    },
    {
      "fieldname": "land_area",
      "fieldtype": "Float",
      "label": "Land Area",
      "reqd": 0
    },
    {
      "fieldname": "total_floors",
      "fieldtype": "Int",
      "label": "Total Floors",
      "reqd": 0
    },
    {
      "fieldname": "total_units",
      "fieldtype": "Int",
      "label": "Total Units",
      "reqd": 0,
      "read_only": 1
    },
    {
      "fieldname": "notes",
      "fieldtype": "Text Editor",
      "label": "Notes",
      "reqd": 0
    },
    {
      "fieldname": "document_status",
      "label": "Document Status",
      "fieldtype": "Select",
      "options": "Draft\nSubmitted\nCancelled",
      "default": "Draft",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "amended_from",
      "label": "Amended From",
      "fieldtype": "Link",
      "options": "Real Estate Project",
      "read_only": 1,
      "no_copy": 1,
      "hidden": 1
    },
    {
      "fieldname": "details_section",
      "label": "Details",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "details_column",
      "label": "Details Column",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "property_section",
      "label": "Property Details",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "project_warehouse",
      "label": "Project Warehouse",
      "fieldtype": "Link",
      "options": "Warehouse"
    },
    {
      "fieldname": "default_income_account",
      "label": "Default Sales Income Account",
      "fieldtype": "Link",
      "options": "Account"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "title_field": "project_name",
  "is_submittable": 1
}
