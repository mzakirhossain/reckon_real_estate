  "autoname": "format:BOQ-{YYYY}-{#####}",
  "is_submittable": 1,
  "track_changes": 1,
  "field_order": [
    "boq_no",
    "details_section",
    "project",
    "effective_date",
    "details_column",
    "company",
    "status",
    "items_section",
    "items",
    "totals_section",
    "total_amount",
    "notes",
    "amended_from"
  ],
  "fields": [
    {
      "fieldname": "project",
      "label": "Real Estate Project",
      "fieldtype": "Link",
      "options": "Real Estate Project",
      "reqd": 1
    },
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "options": "Company",
      "reqd": 1,
      "label": "Company"
    },
    {
      "fieldname": "effective_date",
      "fieldtype": "Date",
      "default": "Today",
      "reqd": 1,
      "label": "Effective Date"
    },
    {
