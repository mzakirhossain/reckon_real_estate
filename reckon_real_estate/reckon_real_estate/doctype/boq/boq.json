      "options": "Draft\nSubmitted\nCancelled",
      "default": "Draft",
      "label": "Status",
      "read_only": 1
    },
    {
      "fieldname": "items",
      "fieldtype": "Table",
      "options": "BOQ Item",
      "reqd": 1,
      "label": "Items"
    },
    {
      "fieldname": "total_amount",
      "fieldtype": "Currency",
      "read_only": 1,
      "label": "Total Amount"
    },
    {
      "fieldname": "notes",
      "fieldtype": "Text Editor",
      "label": "Notes"
    },
    {
      "fieldname": "boq_no",
      "label": "BOQ No",
      "fieldtype": "Data",
      "read_only": 1,
      "in_list_view": 1,
      "unique": 1,
      "no_copy": 1
    },
    {
      "fieldname": "items_section",
      "label": "Items",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "details_section",
      "label": "Details",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "details_column",
      "label": "Details Column",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "totals_section",
      "label": "Totals",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "amended_from",
      "label": "Amended From",
      "fieldtype": "Link",
      "options": "BOQ",
      "read_only": 1,
      "no_copy": 1,
      "hidden": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "title_field": "project"
