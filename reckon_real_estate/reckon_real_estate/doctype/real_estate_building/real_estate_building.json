{
  "doctype": "DocType",
  "name": "Real Estate Building",
  "module": "Reckon Real Estate",
  "autoname": "format:REB-{YYYY}-{#####}",
  "allow_rename": 1,
  "engine": "InnoDB",
  "field_order": [
    "building_code",
    "details_section",
    "building_name",
    "project",
    "details_column",
    "status",
    "document_status",
    "total_floors",
    "notes_section",
    "notes",
    "amended_from"
  ],
  "fields": [
    {
      "fieldname": "building_code",
      "fieldtype": "Data",
      "label": "Building Code",
      "reqd": 0,
      "read_only": 1,
      "unique": 1,
      "no_copy": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "building_name",
      "fieldtype": "Data",
      "label": "Building Name",
      "reqd": 1
    },
    {
      "fieldname": "project",
      "fieldtype": "Link",
      "label": "Project",
      "reqd": 1,
      "options": "Real Estate Project"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "reqd": 0,
      "options": "Active\nInactive",
      "default": "Active"
    },
    {
      "fieldname": "total_floors",
      "fieldtype": "Int",
      "label": "Total Floors",
      "reqd": 0
    },
    {
      "fieldname": "notes",
      "fieldtype": "Small Text",
      "label": "Notes",
      "reqd": 0
    },
    {
      "fieldname": "document_status",
      "label": "Document Status",
      "fieldtype": "Select",
      "options": "Draft\nSubmitted\nCancelled",
      "default": "Draft",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "amended_from",
      "label": "Amended From",
      "fieldtype": "Link",
      "options": "Real Estate Building",
      "read_only": 1,
      "no_copy": 1,
      "hidden": 1
    },
    {
      "fieldname": "details_section",
      "label": "Details",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "notes_section",
      "label": "Notes",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "details_column",
      "label": "Details Column",
      "fieldtype": "Column Break"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "title_field": "building_name",
  "is_submittable": 1
}
