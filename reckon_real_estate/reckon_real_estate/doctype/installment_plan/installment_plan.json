{
  "doctype": "DocType",
  "name": "Installment Plan",
  "module": "Reckon Real Estate",
  "autoname": "format:IP-{YYYY}-{#####}",
  "allow_rename": 1,
  "engine": "InnoDB",
  "field_order": [
    "plan_no",
    "details_section",
    "sales_agreement",
    "booking",
    "customer",
    "project",
    "unit",
    "plan_start_date",
    "frequency",
    "details_column",
    "number_of_installments",
    "down_payment",
    "total_scheduled",
    "status",
    "document_status",
    "sales_invoice",
    "schedule_section",
    "installments",
    "amended_from"
  ],
  "fields": [
    {
      "fieldname": "plan_no",
      "fieldtype": "Data",
      "label": "Plan No",
      "reqd": 0,
      "read_only": 1,
      "unique": 1,
      "no_copy": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "booking",
      "fieldtype": "Link",
      "label": "Booking",
      "reqd": 1,
      "options": "Property Booking"
    },
    {
      "fieldname": "customer",
      "fieldtype": "Link",
      "label": "Customer",
      "reqd": 1,
      "options": "Customer"
    },
    {
      "fieldname": "project",
      "fieldtype": "Link",
      "label": "Project",
      "reqd": 1,
      "options": "Real Estate Project"
    },
    {
      "fieldname": "unit",
      "fieldtype": "Link",
      "label": "Unit",
      "reqd": 1,
      "options": "Real Estate Unit"
    },
    {
      "fieldname": "plan_start_date",
      "fieldtype": "Date",
      "label": "Plan Start Date",
      "reqd": 1
    },
    {
      "fieldname": "frequency",
      "fieldtype": "Select",
      "label": "Frequency",
      "reqd": 0,
      "options": "Monthly\nQuarterly\nHalf-Yearly\nYearly\nCustom",
      "default": "Monthly"
    },
    {
      "fieldname": "number_of_installments",
      "fieldtype": "Int",
      "label": "Number of Installments",
      "reqd": 0
    },
    {
      "fieldname": "down_payment",
      "fieldtype": "Currency",
      "label": "Down Payment",
      "reqd": 0
    },
    {
      "fieldname": "total_scheduled",
      "fieldtype": "Currency",
      "label": "Total Scheduled",
      "reqd": 0,
      "read_only": 1
    },
    {
      "fieldname": "installments",
      "fieldtype": "Table",
      "label": "Installment Schedule",
      "options": "Installment Schedule"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "reqd": 0,
      "options": "Draft\nActive\nCompleted\nCancelled",
      "default": "Draft"
    },
    {
      "fieldname": "document_status",
      "label": "Document Status",
      "fieldtype": "Select",
      "options": "Draft\nSubmitted\nCancelled",
      "default": "Draft",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "amended_from",
      "label": "Amended From",
      "fieldtype": "Link",
      "options": "Installment Plan",
      "read_only": 1,
      "no_copy": 1,
      "hidden": 1
    },
    {
      "fieldname": "schedule_section",
      "label": "Installment Schedule",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "details_section",
      "label": "Details",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "details_column",
      "label": "Details Column",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "sales_agreement",
      "label": "Sales Agreement",
      "fieldtype": "Link",
      "options": "Sales Agreement",
      "reqd": 1
    },
    {
      "fieldname": "sales_invoice",
      "label": "Sales Invoice",
      "fieldtype": "Link",
      "options": "Sales Invoice",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "title_field": "plan_no",
  "is_submittable": 1
}
