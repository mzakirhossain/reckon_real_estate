{
  "doctype": "DocType",
  "name": "Contractor",
  "module": "Reckon Real Estate",
  "autoname": "format:CTR-{#####}",
  "track_changes": 1,
  "field_order": [
    "contractor_no",
    "details_section",
    "contractor_name",
    "supplier",
    "contractor_type",
    "tax_id",
    "details_column",
    "contact_person",
    "phone",
    "email",
    "status",
    "notes_section",
    "notes",
    "amended_from"
  ],
  "fields": [
    {
      "fieldname": "contractor_name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1,
      "label": "Contractor Name"
    },
    {
      "fieldname": "supplier",
      "fieldtype": "Link",
      "options": "Supplier",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "label": "Supplier"
    },
    {
      "fieldname": "contractor_type",
      "fieldtype": "Select",
      "options": "General\nCivil\nElectrical\nPlumbing\nFinishing\nSpecialist\nLabour",
      "default": "General",
      "label": "Contractor Type"
    },
    {
      "fieldname": "tax_id",
      "fieldtype": "Data",
      "label": "Tax ID"
    },
    {
      "fieldname": "contact_person",
      "fieldtype": "Link",
      "options": "Contact",
      "label": "Contact Person"
    },
    {
      "fieldname": "phone",
      "fieldtype": "Data",
      "label": "Phone"
    },
    {
      "fieldname": "email",
      "fieldtype": "Data",
      "options": "Email",
      "label": "Email"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "options": "Draft\nSubmitted\nCancelled",
      "default": "Draft",
      "in_list_view": 1,
      "label": "Status",
      "read_only": 1
    },
    {
      "fieldname": "notes",
      "fieldtype": "Text Editor",
      "label": "Notes"
    },
    {
      "fieldname": "contractor_no",
      "label": "Contractor No",
      "fieldtype": "Data",
      "read_only": 1,
      "in_list_view": 1,
      "unique": 1,
      "no_copy": 1
    },
    {
      "fieldname": "notes_section",
      "label": "Notes",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "details_section",
      "label": "Details",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "details_column",
      "label": "Details Column",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "amended_from",
      "label": "Amended From",
      "fieldtype": "Link",
      "options": "Contractor",
      "read_only": 1,
      "no_copy": 1,
      "hidden": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1
    }
  ],
  "title_field": "contractor_name",
  "is_submittable": 1
}
