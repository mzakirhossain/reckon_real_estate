{
  "doctype": "DocType",
  "name": "Real Estate Project",
  "module": "Reckon Property Management",
  "autoname": "field:project_code",
  "allow_rename": 1,
  "engine": "InnoDB",
  "field_order": [
    "project_code",
    "project_name",
    "company",
    "erpnext_project",
    "cost_center",
    "project_type",
    "status",
    "start_date",
    "expected_completion_date",
    "location",
    "address",
    "land_area",
    "total_floors",
    "total_units",
    "notes"
