      "label": "ERPNext Project",
      "reqd": 0,
      "options": "Project"
    },
    {
      "fieldname": "cost_center",
      "fieldtype": "Link",
      "label": "Cost Center",
      "reqd": 0,
      "options": "Cost Center"
    },
    {
      "fieldname": "project_type",
