    {
      "fieldname": "start_date",
      "fieldtype": "Date",
      "label": "Start Date",
      "reqd": 0
    },
    {
      "fieldname": "expected_completion_date",
      "fieldtype": "Date",
      "label": "Expected Completion Date",
      "reqd": 0
    },
    {
      "fieldname": "location",
      "fieldtype": "Data",
      "label": "Location",
      "reqd": 0
    },
    {
      "fieldname": "address",
      "fieldtype": "Small Text",
      "label": "Address",
      "reqd": 0
    },
    {
      "fieldname": "land_area",
      "fieldtype": "Float",
      "label": "Land Area",
      "reqd": 0
    },
    {
      "fieldname": "total_floors",
      "fieldtype": "Int",
      "label": "Total Floors",
      "reqd": 0
    },
    {
      "fieldname": "total_units",
      "fieldtype": "Int",
      "label": "Total Units",
      "reqd": 0,
      "read_only": 1
    },
    {
      "fieldname": "notes",
      "fieldtype": "Text Editor",
      "label": "Notes",
      "reqd": 0
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1
