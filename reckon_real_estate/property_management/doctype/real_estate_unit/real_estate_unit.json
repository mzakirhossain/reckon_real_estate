{
  "doctype": "DocType",
  "name": "Real Estate Unit",
  "module": "Property Management",
  "autoname": "field:unit_code",
  "allow_rename": 1,
  "engine": "InnoDB",
  "field_order": [
    "unit_code",
    "unit_no",
    "project",
    "building",
    "floor",
    "unit_type",
    "unit_category",
    "area_sqft",
    "bedrooms",
    "bathrooms",
    "facing",
    "base_rate_per_sqft",
    "list_price",
    "status",
    "erpnext_item",
    "description"
