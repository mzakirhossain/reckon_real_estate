      "reqd": 1,
      "unique": 1
    },
    {
      "fieldname": "unit_no",
      "fieldtype": "Data",
      "label": "Unit No",
      "reqd": 1
    },
    {
      "fieldname": "project",
      "fieldtype": "Link",
      "label": "Project",
      "reqd": 1,
      "options": "Real Estate Project"
    },
    {
      "fieldname": "building",
      "fieldtype": "Link",
      "label": "Building",
      "reqd": 1,
      "options": "Real Estate Building"
    },
    {
      "fieldname": "floor",
      "fieldtype": "Link",
      "label": "Floor",
      "reqd": 1,
      "options": "Real Estate Floor"
    },
    {
      "fieldname": "unit_type",
      "fieldtype": "Select",
      "label": "Unit Type",
      "reqd": 0,
      "options": "Apartment\nOffice\nShop\nPlot\nParking\nOther"
    },
    {
      "fieldname": "unit_category",
      "fieldtype": "Data",
      "label": "Unit Category",
      "reqd": 0
    },
    {
      "fieldname": "area_sqft",
      "fieldtype": "Float",
      "label": "Area (Sqft)",
      "reqd": 1
    },
    {
      "fieldname": "bedrooms",
      "fieldtype": "Int",
      "label": "Bedrooms",
      "reqd": 0
    },
    {
      "fieldname": "bathrooms",
      "fieldtype": "Int",
      "label": "Bathrooms",
      "reqd": 0
    },
    {
      "fieldname": "facing",
      "fieldtype": "Data",
      "label": "Facing",
      "reqd": 0
    },
    {
      "fieldname": "base_rate_per_sqft",
      "fieldtype": "Currency",
      "label": "Base Rate / Sqft",
      "reqd": 0
    },
    {
      "fieldname": "list_price",
      "fieldtype": "Currency",
      "label": "List Price",
      "reqd": 0,
      "read_only": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "reqd": 0,
      "options": "Available\nReserved\nBooked\nSold\nBlocked\nCancelled\nHandover Pending\nHanded Over",
      "default": "Available"
    },
    {
      "fieldname": "erpnext_item",
      "fieldtype": "Link",
      "label": "ERPNext Item",
      "reqd": 0,
      "options": "Item"
    },
    {
      "fieldname": "description",
      "fieldtype": "Text Editor",
      "label": "Description",
      "reqd": 0
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1
    }
  ],
  "is_submittable": 0,
  "sort_field": "modified",
  "sort_order": "DESC",
  "title_field": "unit_no"
